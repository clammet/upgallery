# Browser-visible local-development URLs.
# 3210 is the Convex client API. 3211 is the Convex HTTP Actions origin used
# by OAuth; it is not the Vite URL, and its bare root returning 404 is normal.
VITE_CONVEX_URL=http://localhost:3210
VITE_CONVEX_SITE_URL=http://localhost:3211
# devsetup also applies this value to Convex as AUTH_GOOGLE_ID.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Blank uses Vite's development proxy for the local storage gateway.
VITE_STORAGE_API_URL=

# Local server settings. Vite only exposes VITE_-prefixed values to browser
# code. devsetup applies these values to the local Convex deployment and also
# copies STORAGE_INTERNAL_SECRET to .env.storage.local.
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
DEFAULT_ADMIN_EMAIL=
SITE_URL=http://localhost:5173
STORAGE_INTERNAL_SECRET=replace-with-a-long-random-value
