{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "customManagers:githubActionsVersions"],
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": true,
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Majors wait for a human",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Pins and digest refreshes point at code that already shipped - no soak needed",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "minimumReleaseAge": null
    },
    {
      "description": "0.x minors are breaking by semver convention - hold them for a human",
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "sharp is compiled against the libvips built in the Dockerfile; update them together so compatibility is proven by a single Docker build",
      "groupName": "sharp + libvips",
      "matchPackageNames": ["sharp", "libvips/libvips"]
    },
    {
      "description": "Renovate engine: several releases a day, so take the weekly one; no digest pin because the annotated RENOVATE_VERSION env var holds a plain tag",
      "matchDepNames": ["ghcr.io/renovatebot/renovate"],
      "schedule": ["before 6am on monday"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the source-built libvips in the Dockerfile: bumps VIPS_VERSION and refreshes VIPS_SHA256 from the release tarball",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG VIPS_TAG=(?<currentValue>v[\\d.]+)\\nARG VIPS_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "libvips/libvips",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    }
  ]
}
