{
  "name": "upgallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "devsetup": "node scripts/devsetup.mjs",
    "dev": "concurrently -k -n convex,storage-api,storage-worker,web \"convex dev\" \"tsx watch --env-file=.env.storage.local storage/server.ts\" \"tsx watch --env-file=.env.storage.local storage/worker.ts\" \"vite\"",
    "dev:docker": "node scripts/dev-docker.mjs",
    "dev:docker:stop": "node scripts/dev-docker.mjs --stop",
    "dev:web": "vite",
    "dev:storage": "concurrently -k -n storage-api,storage-worker \"tsx watch --env-file=.env.storage.local storage/server.ts\" \"tsx watch --env-file=.env.storage.local storage/worker.ts\"",
    "dev:storage-api": "tsx watch --env-file=.env.storage.local storage/server.ts",
    "dev:storage-worker": "tsx watch --env-file=.env.storage.local storage/worker.ts",
    "profile:chrome": "node scripts/profile-chrome.mjs",
    "profile:upload": "node scripts/profile-upload.mjs",
    "profile:analyze": "node scripts/profile-analyze.mjs",
    "build": "tsc -b && vite build && tsc -p storage/tsconfig.json",
    "check": "tsc -b && tsc -p convex/tsconfig.json --noEmit && tsc -p storage/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:storage": "node storage-dist/server.js",
    "start:storage-worker": "node storage-dist/worker.js",
    "sharp:build-heic": "SHARP_FORCE_GLOBAL_LIBVIPS=1 pnpm --dir node_modules/sharp run build",
    "sharp:check-heic": "node scripts/check-sharp-heic.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "@clammet/convex-googly-auth": "1.0.1",
    "busboy": "1.6.0",
    "convex": "1.45.0",
    "convex-helpers": "0.1.123",
    "exifr": "7.1.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "highlight.js": "11.12.0",
    "lucide-react": "1.38.0",
    "mime-types": "3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "convex-test": "0.0.56",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.0.2",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-checker": "0.14.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "26.8.1"
  },
  "packageManager": "pnpm@11.25.0"
}
