WEB_PORT=8080

# Existing Convex deployment supplied by the surrounding infrastructure.
# The first two URLs are compiled into the browser bundle. The storage URL may
# use an internal/private route to the same deployment's HTTP Actions service.
PUBLIC_CONVEX_URL=https://convex.example.com
PUBLIC_CONVEX_SITE_URL=https://convex-actions.example.com
STORAGE_CONVEX_SITE_URL=https://convex-actions.example.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Generate a long random value and set the identical value in Convex.
STORAGE_INTERNAL_SECRET=replace-with-at-least-32-random-characters

# Host paths. These are examples and should be absolute in the uncommitted
# deployment .env file.
UPGALLERY_SHARED_ROOT=./data/shared
UPGALLERY_USER_ROOT=./data/users
UPGALLERY_UPLOADER_ROOT=./data/uploaders
UPGALLERY_DERIVATIVE_ROOT=./data/derivatives

# Startup guard for bind-mounted roots (docs/deployment.md, "Mount sentinels").
# List the paths under STORAGE_ROOT that are separate mounts and put an empty
# STORAGE_ROOT_SENTINEL file at the top of each once the volume is mounted.
# Unset disables the check.
# STORAGE_MOUNT_ROOTS=public/shared,public/users,protected/uploaders,derivatives
# STORAGE_ROOT_SENTINEL=.upgallery-storage-root

MAX_ABSOLUTE_UPLOAD_BYTES=10737418240
STORAGE_POLL_INTERVAL_MS=1000
STORAGE_HEARTBEAT_INTERVAL_MS=30000
STORAGE_SHUTDOWN_GRACE_MS=60000
STORAGE_TEMP_MAX_AGE_MS=86400000
STORAGE_FFMPEG_TIMEOUT_MS=300000
STORAGE_WORKER_TASK_TIMEOUT_MS=3600000

STORAGE_MAX_CONCURRENT_UPLOADS=4
STORAGE_MAX_QUEUED_UPLOADS=16
STORAGE_MAX_CONCURRENT_DOWNLOADS=16
STORAGE_MAX_QUEUED_DOWNLOADS=64
STORAGE_MAX_CONCURRENT_FILESYSTEM_OPERATIONS=2
STORAGE_MAX_QUEUED_FILESYSTEM_OPERATIONS=16
STORAGE_MEDIA_WORKER_CONCURRENCY=2
STORAGE_SYNC_WORKER_CONCURRENCY=2
STORAGE_SHARP_CONCURRENCY=1

STORAGE_API_MEMORY_LIMIT=1g
STORAGE_API_CPU_LIMIT=1.0
STORAGE_WORKER_MEMORY_LIMIT=2g
STORAGE_WORKER_CPU_LIMIT=2.0
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.5
