server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  client_max_body_size 0;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  location /api/storage/ {
    proxy_pass http://${STORAGE_UPSTREAM};
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # User-backed paths can be edited in place, so they must be revalidated.
  location ^~ /media/users/ {
    alias /data/media/public/users/;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "public, max-age=0, must-revalidate" always;
    try_files $uri =404;
  }

  # Shared gallery paths are content-addressed and immutable. The protected
  # uploader tree is not reachable here or mounted in this container.
  location /media/ {
    alias /data/media/public/;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache" always;
  }
}
