PORT=8787
WORKER_HEALTH_PORT=8788
# The local Convex HTTP Actions origin, not VITE_CONVEX_URL or the Vite URL.
CONVEX_SITE_URL=http://localhost:3211
# This must exactly match STORAGE_INTERNAL_SECRET on the Convex deployment.
STORAGE_INTERNAL_SECRET=replace-with-the-same-long-random-value-used-by-convex
STORAGE_ROOT=.storage
STORAGE_POLL_INTERVAL_MS=1000
STORAGE_HEARTBEAT_INTERVAL_MS=30000
STORAGE_SHUTDOWN_GRACE_MS=60000
STORAGE_TEMP_MAX_AGE_MS=86400000
STORAGE_FFMPEG_TIMEOUT_MS=300000
STORAGE_WORKER_TASK_TIMEOUT_MS=3600000
STORAGE_MAX_CONCURRENT_UPLOADS=4
STORAGE_MAX_QUEUED_UPLOADS=16
STORAGE_MAX_CONCURRENT_DOWNLOADS=16
STORAGE_MAX_QUEUED_DOWNLOADS=64
STORAGE_MAX_CONCURRENT_FILESYSTEM_OPERATIONS=2
STORAGE_MAX_QUEUED_FILESYSTEM_OPERATIONS=16
STORAGE_MEDIA_WORKER_CONCURRENCY=2
STORAGE_SYNC_WORKER_CONCURRENCY=2
STORAGE_SHARP_CONCURRENCY=1
MAX_ABSOLUTE_UPLOAD_BYTES=10737418240
