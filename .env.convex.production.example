# Emergency/manual production Convex CLI target only. Application environment
# values do not belong here; yuzuyu reconciles them from its Ansible Vault.
# Copy this file to
# .env.convex.production.local and keep the copy uncommitted.
#
# Always pass the copy explicitly with `--env-file`. Do not add these values
# to .env.local: that file selects the project-local development deployment.
CONVEX_SELF_HOSTED_URL=https://upgallery-convex.nyanya.org
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-generated-admin-key
